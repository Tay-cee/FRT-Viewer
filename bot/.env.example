# Copy to bot/.env and fill in. Real environment variables override these.

# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# Your server's ID (right-click server -> Copy Server ID, needs Developer Mode).
# Set it so slash commands show up instantly; without it they register globally (slower).
FRT_GUILD_ID=

# Comma-separated Discord user IDs allowed to run /import.
# If empty, anyone with the Administrator permission in the server can.
FRT_ADMIN_IDS=

# Channel that gets a post whenever a new report has been imported (optional)
FRT_ANNOUNCE_CHANNEL_ID=

# 1 = watch FRT_REPORT_DIR and import new PDFs automatically
FRT_AUTO_IMPORT=0
FRT_WATCH_MINUTES=10

# Paths (defaults shown, relative to the project folder)
#FRT_DB=../frt.db
#FRT_BIN=../frt
#FRT_REPORT_DIR=../frt-report

# Images attached to records: stored as images/<FRN>/<file> (you can copy files in by hand)
#FRT_IMAGE_DIR=../images
# Who may /image add: "admins" (FRT_ADMIN_IDS / server admins) or "everyone"
FRT_IMAGE_UPLOADERS=admins
FRT_IMAGE_MAX_MB=8
